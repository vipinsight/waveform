{
  "name": "waveform",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "Local-first desktop voice transcription with selectable speech models.",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && node scripts/build-helper.mjs",
    "start": "./scripts/run-tauri.sh",
    "app": "./scripts/run-tauri.sh",
    "package:mac": "WAVEFORM_PROFILE=release ./scripts/run-tauri.sh",
    "dmg": "tauri build --bundles dmg && scripts/finish-dmg.sh",
    "bump": "scripts/bump.sh",
    "release": "./scripts/release.sh",
    "test": "vitest run && cd src-tauri && cargo test",
    "test:ui": "vitest run",
    "test:release": "python3 -m unittest discover -s tests -p '*_test.py'",
    "test:rust": "cd src-tauri && cargo test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup:model": "./scripts/setup-model.sh",
    "setup:qwen": "./scripts/setup-qwen.sh",
    "setup:whisper-cpp": "./scripts/setup-whisper-cpp.sh",
    "icon": "./.venv-qwen/bin/python scripts/generate-icon.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.9",
    "lucide-static": "^1.41.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
