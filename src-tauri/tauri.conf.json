{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waveform",
  "version": "0.2.0",
  "identifier": "com.webtiara.waveform",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Waveform",
        "visible": false,
        "url": "index.html",
        "width": 940,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 25,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../dist/native/waveform-hotkey": "waveform-hotkey",
      "../scripts/qwen-worker.py": "qwen-worker.py",
      "../scripts/whisper-worker.py": "whisper-worker.py"
    }
  }
}
