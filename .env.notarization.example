# Copy to .env.notarization; fill locally. Never commit real credentials.
APPLE_ID='your-apple-id@example.com'
APPLE_PASSWORD='your-app-specific-password'
APPLE_TEAM_ID='YOURTEAMID'
APPLE_SIGNING_IDENTITY='Developer ID Application: Your Name (YOURTEAMID)'
# Optional; defaults to ~/.tauri/waveform.key.
# TAURI_SIGNING_PRIVATE_KEY_PATH='/absolute/path/to/waveform.key'
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD='your-updater-key-password'
